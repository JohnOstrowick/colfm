#ifndef CONTEXTMENU_H
#define CONTEXTMENU_H

#include <QMenu>
#include <QContextMenuEvent>
#include <QMessageBox>
#include <QProcess>
#include <QInputDialog>
#include <QFileInfo>
#include <QDesktopServices>
#include <QUrl>

// "Open With" utility function
inline void ColFM::openWith(const QString &filePath) {
    QFileInfo fi(filePath);
    QString ext = fi.suffix().toLower();

    QStringList guiApps;
    if (ext == "png" || ext == "jpg" || ext == "jpeg" || ext == "gif") {
        guiApps << "gimp" << "ristretto" << "eog";
    } else if (ext == "mp4" || ext == "mkv" || ext == "avi") {
        guiApps << "vlc" << "mpv";
    } else if (ext == "mp3" || ext == "wav" || ext == "ogg") {
        guiApps << "vlc" << "audacious";
    } else if (ext == "pdf") {
        guiApps << "evince" << "okular";
    } else if (ext == "odt" || ext == "ods" || ext == "odp" || ext == "docx" || ext == "xlsx" || ext == "pptx") {
        guiApps << "libreoffice";
    } else {
        guiApps << "xdg-open";
    }

    bool ok;
    QString app = QInputDialog::getItem(nullptr, "Open With", "Choose an application:", guiApps, 0, false, &ok);
    if (ok && !app.isEmpty()) {
        QProcess::startDetached(app, QStringList() << filePath);
    }
}

// Main context menu logic
inline void ColFM::showContextMenu(QContextMenuEvent *event) {
    QModelIndex idx = currentIndex();
    if (!idx.isValid()) return;

    QString filePath = model->filePath(idx);
    QFileInfo fi(filePath);

    QMenu menu(this);
    QAction *openAct    = menu.addAction("Open");
    QAction *copyAct    = menu.addAction("Copy");
    QAction *renameAct  = menu.addAction("Rename");
    QAction *trashAct   = menu.addAction("Move to Trash");
    QAction *linkAct    = menu.addAction("Create Link");
    QAction *openWith   = menu.addAction("Open With...");

    QAction *chosen = menu.exec(event->globalPos());
    if (!chosen) return;

    if (chosen == openAct) {
        QDesktopServices::openUrl(QUrl::fromLocalFile(filePath));
    } else if (chosen == copyAct) {
        onDuplicate();
    } else if (chosen == renameAct) {
        onRename();
    } else if (chosen == trashAct) {
        onMoveToTrash();
    } else if (chosen == linkAct) {
        onCreateSoftlink();
    } else if (chosen == openWith) {
        this->openWith(filePath);
    }
}

#endif // CONTEXTMENU_H
